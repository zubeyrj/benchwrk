 "ex": {
  "t": "Word counts",
  "md": "Write `word_counts(text: str) -> dict[str, int]` that lowercases the text, splits on whitespace, strips the punctuation `.,!?;:` from each word's ends, drops empty words and counts each word.",
  "sol": "def word_counts(text: str) -> dict[str, int]:\n    counts: dict[str, int] = {}\n    for w in text.lower().split():\n        w = w.strip('.,!?;:')\n        if w:\n            counts[w] = counts.get(w, 0) + 1\n    return counts\n",
  "tests": [
   "basic",
   "empty",
   "punctuation only"
  ]
 }
